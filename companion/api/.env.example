# Cloudflare R2 (S3 API). The bucket MUST be private (no public access, no r2.dev URL).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wowcensus-uploads
# Sign the bundle SHA-256 into the presigned PUT (set false if your R2 setup rejects it).
R2_SIGN_CHECKSUM=true

# Upstash Redis (rate limits, pending uploads, receipts, ingest stream)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Pilot auth: SHA-256 hex of the single test device token (never the token itself).
#   node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" "<token>"
DEMO_DEVICE_TOKEN_SHA256=

# Optional limits
PRESIGN_TTL_SECONDS=120
MAX_ZIP_BYTES=67108864
MAX_LUA_BYTES=268435456
INGEST_STREAM=wowcensus:ingest
RECEIPT_TTL_SECONDS=7776000
