#!/bin/sh
# Brings cached pages up to date after a code release. Run it (in the background) right after
# switching /srv/wowcensus/current; nginx's page cache is never emptied, so without this every
# cached page keeps the old release's HTML.
#   1. waits RELEASE_SETTLE_SECONDS (120) so PHP's realpath cache stops serving the old release
#      (a rollout started sooner re-caches old HTML);
#   2. runs one full pass of wowcensus-data-refresh (REFRESH_FULL=1), waiting for the lock if a
#      data publish is running. That pass publishes any data waiting to go live too, so a
#      release and new data cost one re-render of every page, not two. A release whose code an
#      earlier full pass already rendered (several releases queued behind one rollout) is
#      skipped, as long as no new data arrived meanwhile.
# wowcensus-rollout purges each re-rendered page from Cloudflare when cloudflare.env is set up.
# Usage: nohup /usr/local/bin/wowcensus-release-rollout >> /var/log/wowcensus-data-refresh.log 2>&1 &
set -eu
log() { echo "$(date -u +%FT%TZ) $*"; }
sleep "${RELEASE_SETTLE_SECONDS:-120}"
RELEASE=$(readlink -f /srv/wowcensus/current)
log "code release $RELEASE: waiting for the data-refresh lock"
FORCE=1 REFRESH_FULL=1 REFRESH_WAIT=1 RELEASE="$RELEASE" exec /usr/local/bin/wowcensus-data-refresh
