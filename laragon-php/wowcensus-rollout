#!/bin/bash
# Re-renders every page in nginx's cache in place, one at a time, so new data reaches
# visitors gradually without ever emptying the cache: each visitor keeps getting the
# saved copy of a page until this replaces it (X-WoWCensus-Refresh: 1 from 127.0.0.1).
# Order: the 72 main pages, then the rest by visits in the recent access logs.
# Waits while the box is busy (1-minute load above ROLLOUT_MAX_LOAD) so visitors come first.
# After each default-skin HTML page is re-rendered, its URL is purged from Cloudflare (in
# batches of 30), so the edge can keep pages for a long time and still show changes at once.
# The purge needs CF_ZONE_ID and CF_API_TOKEN (Zone > Cache Purge) in /etc/wowcensus/cloudflare.env;
# without that file pages are only re-rendered and the edge copy lasts its own TTL.
# Called by wowcensus-data-refresh after new data is published and by wowcensus-release-rollout
# after a code release; safe to run by hand.
#   ROLLOUT_PAUSE_SECONDS (1)  pause between pages
#   ROLLOUT_MAX_LOAD (1.5)     wait while the load average is above this
#   ROLLOUT_SOURCES="a b"      only these editions' pages plus the home page (wowcensus-data-refresh
#                              passes the editions whose data changed); empty = every page
#   ROLLOUT_MAIN=1             only the main pages (every skin and Accept variant of them)
#   ROLLOUT_LIMIT              only the first N cache entries (uri x skin x accept; for testing)
#   ROLLOUT_DRY_RUN=1          list how many entries per top-level path it would re-render, then stop
set -u
CF_ENV=/etc/wowcensus/cloudflare.env
CF_ZONE_ID=; CF_API_TOKEN=
[ -r "$CF_ENV" ] && . "$CF_ENV"
CACHE=/var/cache/nginx/wowcensus
HOST=wowcensus.io
PAUSE=${ROLLOUT_PAUSE_SECONDS:-1}
MAX_LOAD=${ROLLOUT_MAX_LOAD:-1.5}
WORK=$(mktemp -d); trap 'rm -rf "$WORK"' EXIT
log() { echo "$(date -u +%FT%TZ) $*"; }

# Cache keys look like GET|host|uri|skin|accept|code|data (snippets/wowcensus-cache.conf).
find "$CACHE" -type f -print0 | xargs -0 -n 500 grep -a -h -m1 '^KEY: ' 2>/dev/null \
  | sed 's/^KEY: //' | awk -F'|' -v h="$HOST" 'NF==7 && $1=="GET" && $2==h {print $3"|"$4"|"$5}' | sort -u > "$WORK/cached"
# (NF==7 skips keys from before the Accept field was added: their 5th field is the old release
# path, and nothing reads those entries any more.)

# Visits per path from the current and previous access logs.
{ cat /var/log/nginx/access.log /var/log/nginx/access.log.1 2>/dev/null; zcat -f /var/log/nginx/access.log.[2-7].gz 2>/dev/null; } \
  | awk '$6=="\"GET" {print $7}' | sort | uniq -c | awk '{print $2"\t"$1}' > "$WORK/hits"

# The main pages (same list as warm-cache.sh) first.
for d in "" forever/ tbc/ classic/ mop/ retail/ sod/ hardcore/ forever-beta/; do
  for p in "" realms guilds auctionhouse geography talents gear combos; do
    u="/$d$p"; [ "$d" = "" ] && [ "$p" != "" ] && u="/$p"; echo "$u"
  done
done > "$WORK/main"
awk '{print $0"\t999999999"}' "$WORK/main" >> "$WORK/hits"

# ROLLOUT_SOURCES: only the pages of these editions (importer source keys, as in
# local_imports.source_game), plus the pages that show every edition (home page, sitemap,
# llms.txt). The site root is Forever, so its top-level pages (/realms, /guilds, ...) go
# with forever. Keys without pages (forever-unmapped) select nothing else.
dirs=; top=0
for s in ${ROLLOUT_SOURCES:-}; do
  case "$s" in
    forever) dirs="$dirs forever"; top=1 ;;
    classic-beta) dirs="$dirs forever-beta" ;;
    classic-progression) dirs="$dirs tbc" ;;
    mop-classic) dirs="$dirs mop" ;;
    classic|sod|hardcore|retail) dirs="$dirs $s" ;;
  esac
done

awk -F'\t' 'NR==FNR {if ($2>h[$1]) h[$1]=$2; next} {split($0,k,"|"); print (h[k[1]]+0)"\t"$0}' "$WORK/hits" "$WORK/cached" \
  | sort -t$'\t' -k1,1nr | cut -f2 \
  | awk -v main_only="${ROLLOUT_MAIN:-0}" -v sources="${ROLLOUT_SOURCES:-}" -v dirs="$dirs" -v top="$top" -v mainf="$WORK/main" '
      BEGIN {
        while ((getline m < mainf) > 0) main[m] = 1
        n = split(dirs, d, " "); for (i = 1; i <= n; i++) want[d[i]] = 1
        split("forever forever-beta tbc classic mop retail sod hardcore", e, " "); for (i in e) edition[e[i]] = 1
      }
      {
        split($0, k, "|"); uri = k[1]; path = uri; sub(/\?.*/, "", path)
        if (main_only == 1 && !(uri in main)) next
        if (sources == "") { print; next }
        seg = path; sub(/^\//, "", seg); sub(/\/.*/, "", seg)
        # The home page itself always; its query variants (/?fbclid=...) are top-level pages
        # and go with forever (each home render takes ~20 s, and there are dozens of them).
        if (uri == "/" || uri ~ /^\/(index\.(html|md)|sitemap\.xml|llms\.txt)$/) { print; next }
        if (seg in want || (top && !(seg in edition))) print
      }' \
  | head -n "${ROLLOUT_LIMIT:-100000000}" > "$WORK/order"
total=$(wc -l < "$WORK/order")
note=; [ "${ROLLOUT_MAIN:-0}" = 1 ] && note=" (main pages only)"
log "rolling out $total cached pages${ROLLOUT_SOURCES:+ (editions: $ROLLOUT_SOURCES)}$note"
if [ "${ROLLOUT_DRY_RUN:-0}" = 1 ]; then
  cut -d'|' -f1 "$WORK/order" | sed -E 's#\?.*##; s#^/([^/]*).*#\1#' | sort | uniq -c | sort -rn | head -20
  exit 0
fi

# Cloudflare purge, batched. Only default-skin HTML is cached at the edge (the Cache Rule
# bypasses other skins and Markdown), and only the apex serves pages (www and d. redirect).
: > "$WORK/purge"; purged=0
purge() {
  [ -n "$CF_ZONE_ID" ] && [ -n "$CF_API_TOKEN" ] && [ -s "$WORK/purge" ] || { : > "$WORK/purge"; return 0; }
  body=$(sed 's/[\\"]/\\&/g; s#^#"https://'"$HOST"'#; s/$/"/' "$WORK/purge" | paste -sd, -)
  out=$(curl -s -m 30 -X POST "https://api.cloudflare.com/client/v4/zones/$CF_ZONE_ID/purge_cache" \
          -H "Authorization: Bearer $CF_API_TOKEN" -H 'Content-Type: application/json' \
          --data "{\"files\":[$body]}")
  case "$out" in
    *'"success":true'*) purged=$((purged + $(wc -l < "$WORK/purge"))) ;;
    *) log "cloudflare purge failed: $(printf '%s' "$out" | head -c 300)" ;;
  esac
  : > "$WORK/purge"
}

n=0; ok=0; failed=0; streak=0; started=$(date +%s)
while IFS='|' read -r uri skin accept; do
  n=$((n+1))
  waited=0
  while awk -v m="$MAX_LOAD" '{exit !($1>m)}' /proc/loadavg && [ $waited -lt 600 ]; do sleep 10; waited=$((waited+10)); done
  hdr=(); [ "$accept" = md ] && hdr=(-H 'Accept: text/markdown')
  cookie=(); [ "$skin" != wow2008 ] && cookie=(-H "Cookie: wowcensus_skin=$skin")
  r=$(curl -sk -o /dev/null -m 300 -H "Host: $HOST" -H 'X-WoWCensus-Refresh: 1' "${hdr[@]}" "${cookie[@]}" \
        -w '%{http_code} %{time_total}' "https://127.0.0.1$uri")
  case "$r" in
    "200 "*) ok=$((ok+1)); streak=0
       if [ "$skin" = wow2008 ] && [ "$accept" != md ]; then
         echo "$uri" >> "$WORK/purge"; [ "$(wc -l < "$WORK/purge")" -ge 30 ] && purge
       fi ;;
    *) failed=$((failed+1)); streak=$((streak+1)); log "failed: $uri ($skin $accept) $r"
       [ $streak -ge 20 ] && { log "stopping: 20 failures in a row ($ok ok, $failed failed of $total)"; exit 1; } ;;
  esac
  [ $((n % 100)) -eq 0 ] && log "$n/$total pages ($ok ok, $failed failed, $(( $(date +%s) - started ))s)"
  sleep "$PAUSE"
done < "$WORK/order"
purge
log "rollout done: $ok ok, $failed failed of $total, $purged purged at Cloudflare, in $(( $(date +%s) - started ))s"
