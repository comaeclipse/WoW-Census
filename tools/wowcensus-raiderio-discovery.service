[Unit]
Description=Discover missing Retail characters from Raider.IO
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=postgres
EnvironmentFile=/etc/wowcensus/raiderio.env
Environment="MARKETLENS_PG_DSN=dbname=marketlens user=postgres"
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -u /srv/wowcensus/tools/hourly-armory/discover-raiderio-characters.py
TimeoutStartSec=15min
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
